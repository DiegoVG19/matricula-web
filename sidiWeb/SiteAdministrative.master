<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="SiteAdministrative.master.cs" Inherits="sidiWeb.SiteAdministrative" %>

<!DOCTYPE html>

<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIDI WEB - IDI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link href="Resources/adminStyles.css" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <!-- Top Navbar -->
        <nav class="navbar navbar-expand-lg top-navbar">
            <div class="container-fluid">
                <button class="navbar-toggler d-lg-none" type="button" id="sidebarToggle">
                    <i class="fas fa-bars"></i>
                </button>
                <a class="navbar-brand text-white d-flex align-items-center" href="https://idiomas.unjfsc.edu.pe/">
                    <img src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/logo-blanco-A1JJhAwKMF7P9YztGcsdqNthXCz5tK.png" alt="IDIOMAS FAUSTINO Logo" class="institute-logo" style="max-height: 40px; width: auto;" />
                </a>
                <div class="ms-auto">
                    <div class="dropdown">
                        <button class="btn text-white" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle fa-lg"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="dropdownMenuButton">
                            <li>
                                <asp:LinkButton ID="btnEditarPerfil" runat="server" CssClass="dropdown-item" OnClick="btnEditarPerfil_Click">
                            <i class="fas fa-user-edit me-2"></i>Editar Perfil
                                </asp:LinkButton>
                            </li>
                            <li>
                                <asp:LinkButton ID="bntCambiarContra" runat="server" CssClass="dropdown-item" OnClick="btnCambiarContra_Click">
                            <i class="fas fa-key me-2"></i>Cambiar contraseña
                                </asp:LinkButton>
                            </li>
                            <li>
                                <hr class="dropdown-divider" />
                            </li>
                            <li>
                                <asp:LinkButton ID="btnCerrarSesion" runat="server" CssClass="dropdown-item text-danger" OnClick="btnCerrarSesion_Click">
                            <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
                                </asp:LinkButton>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <div class="container-fluid">
            <div class="row">
                <!-- Sidebar -->
                <div class="col-md-3 col-lg-2 sidebar">

                    <div class="nav flex-column">
                        <asp:LinkButton ID="btnPerfil" runat="server" OnClick="btnVerPerfil_Click" class="nav-link">
                    <i class="fas fa-user"></i> Perfil
                        </asp:LinkButton>
                        <asp:LinkButton ID="btnBuscar" runat="server" OnClick="btnBuscarAlumno_Click" class="nav-link">
                    <i class="fas fa-user"></i> Resumen por alumno
                        </asp:LinkButton>
                       <asp:LinkButton ID="btnGrupos" runat="server" OnClick="btnGrupos_Click" class="nav-link">
                    <i class="fas fa-user-circle"></i> Grupos
                        </asp:LinkButton>
                        <a href="https://unjfsc.edu.pe/aulavirtual/idiomas/login/index.php" target="_blank" class="nav-link">
                            <i class="fas fa-user-circle"></i>AULA VIRTUAL
                        </a>
                        <!--<a href="#" class="nav-link">
                    <i class="fas fa-file-alt"></i>Ficha de matrícula
                </a>-->
                    </div>
                    <div class="social-links">
                        <div class="mb-2 fw-bold">Encuéntranos en:</div>
                        <a href="https://www.facebook.com/IdiomasFaustino" target="_blank"><i class="fab fa-facebook"></i></a>
                        <a href="https://wa.link/g3gox5" target="_blank"><i class="fab fa-whatsapp"></i></a>
                        <a href="https://wa.link/zfdbfh" target="_blank"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>

                <!-- Main Content -->
                <div class="col-md-9 col-lg-10 content-wrapper">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                        <!-- El contenido específico de cada página irá aquí -->
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#sidebarToggle').click(function () {
                    $('.sidebar').toggleClass('active');
                });

                $(document).click(function (event) {
                    var sidebar = $('.sidebar');
                    var sidebarToggle = $('#sidebarToggle');
                    if (!sidebar.is(event.target) && sidebar.has(event.target).length === 0 &&
                        !sidebarToggle.is(event.target) && sidebarToggle.has(event.target).length === 0) {
                        sidebar.removeClass('active');
                    }
                });
                document.querySelectorAll('[style="position: fixed; z-index: 2147483647; left: 0px; bottom: 0px; height: 65px; right: 0px; display: block; width: 100%; background-color: transparent; margin: 0px; padding: 0px;"], [style="opacity: 0.9; z-index: 2147483647; position: fixed; left: 0px; bottom: 0px; height: 65px; right: 0px; display: block; width: 100%; background-color: #202020; margin: 0px; padding: 0px;"]').forEach(el => {
                    el.style.display = 'none';
                });
            });
        </script>
        <asp:ContentPlaceHolder ID="Scripts" runat="server">
            <!-- Scripts específicos de cada página irán aquí -->
        </asp:ContentPlaceHolder>
    </form>
</body>
</html>
